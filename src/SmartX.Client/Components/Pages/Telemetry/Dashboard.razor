@page "/telemetry"
@rendermode InteractiveServer
@using System.Globalization
@using SmartX.Shared.Dtos
@using SmartX.Shared.Models
@using SmartX.Client.Services
@inject SmartXApiClient Api
@implements IAsyncDisposable

<PageTitle>Smart-X · Telemetry Dashboard</PageTitle>

<div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px;">
    <div>
        <h1>Telemetry Dashboard</h1>
        <p>
            Real-time visual feedback: trend sparklines, delta indicators and threshold colour coding,
            sorted so the sensors that need attention come first.
        </p>
    </div>
    <span class="live-pill @(_apiOnline ? "" : "offline")">@(_apiOnline ? "Live · every 2s" : "API offline")</span>
</div>

@if (!_apiOnline)
{
    <div class="banner banner-error" style="margin-bottom:16px;">
        Can't reach the Smart-X API. Start <strong>SmartX.Api</strong> and this page will reconnect on its own.
    </div>
}

@if (_sensors is null)
{
    <p class="field-hint">Loading sensors...</p>
}
else if (_sensors.Count == 0)
{
    <div class="empty-state empty-hero">
        <h2 style="margin-bottom:6px;">No sensors yet</h2>
        <p style="margin:0 0 16px;">Register a device to start streaming live telemetry onto this dashboard.</p>
        <a class="btn btn-primary" href="sensors/register">Register your first sensor &rarr;</a>
    </div>
}
else
{
    <div class="kpi-strip" style="margin-top:0;">
        <div class="kpi kpi-wide">
            <div class="health-card">
                <div class="donut-wrap">
                    <svg class="donut" viewBox="0 0 100 100">
                        <circle class="donut-track" cx="50" cy="50" r="38" />
                        <circle class="donut-value @DonutTone()" cx="50" cy="50" r="38" stroke-dasharray="@DonutDash()" />
                    </svg>
                    <div class="donut-center">@(_snapshots.Count == 0 ? "—" : $"{HealthyPercent}%")</div>
                </div>
                <div>
                    <div class="kpi-label">Fleet health</div>
                    <div class="kpi-sub" style="margin-top:6px; font-size:0.84rem;">
                        @CountOf(TelemetryStatus.Normal) of @_snapshots.Count reporting sensors are operating normally.
                    </div>
                    <div class="kpi-sub">@_sensors.Count registered in total</div>
                </div>
            </div>
        </div>

        <div class="kpi good">
            <div class="kpi-label">Normal</div>
            <div class="kpi-value">@CountOf(TelemetryStatus.Normal)</div>
            <div class="kpi-sub">within threshold</div>
        </div>
        <div class="kpi warn">
            <div class="kpi-label">Warning</div>
            <div class="kpi-value">@CountOf(TelemetryStatus.Warning)</div>
            <div class="kpi-sub">drifting from baseline</div>
        </div>
        <div class="kpi bad">
            <div class="kpi-label">Anomalous</div>
            <div class="kpi-value">@CountOf(TelemetryStatus.Anomalous)</div>
            <div class="kpi-sub">sudden spike or drop</div>
        </div>
        <div class="kpi off">
            <div class="kpi-label">Disconnected</div>
            <div class="kpi-value">@CountOf(TelemetryStatus.Disconnected)</div>
            <div class="kpi-sub">no recent telemetry</div>
        </div>
    </div>

    <div class="panel" style="margin-top:18px; display:flex; flex-wrap:wrap; gap:10px; align-items:center;">
        <span class="field-hint">Simulate readings for:</span>
        @foreach (var s in _sensors)
        {
            <button class="btn btn-sm @(IsRunning(s.Id) ? "btn-primary" : "")"
                    @onclick="() => ToggleSimulationAsync(s.Id)">
                @(IsRunning(s.Id) ? "■ Stop " : "▶ Start ") @s.Location.NodeId
            </button>
        }
        <span style="flex:1;"></span>
        <button class="btn btn-sm" @onclick="ManualRefreshAsync">↻ Refresh now</button>
        <span class="field-hint">Last polled @_lastPolled.ToString("HH:mm:ss")</span>
    </div>

    @if (_sensors.Count >= 2)
    {
        <div class="panel" style="margin-top:12px; display:flex; flex-wrap:wrap; gap:10px; align-items:center;">
            <span class="field-hint">Aggregate demo (operator overload, Meter3 = Meter1 + Meter2):</span>
            <select @bind="_meterA">
                @foreach (var s in _sensors)
                {
                    <option value="@s.Id">@s.Location.NodeId</option>
                }
            </select>
            <span class="field-hint">+</span>
            <select @bind="_meterB">
                @foreach (var s in _sensors)
                {
                    <option value="@s.Id">@s.Location.NodeId</option>
                }
            </select>
            <button class="btn btn-sm" @onclick="AggregateAsync">Compute</button>
            @if (!string.IsNullOrEmpty(_aggregateResult))
            {
                <span class="chip accent">@_aggregateResult</span>
            }
        </div>
    }

    <div class="chip-row" style="margin-top:18px;">
        <button class="filter-chip @(_statusFilter is null ? "active" : "")" @onclick="() => SetFilter(null)">
            All <span class="count">@_snapshots.Count</span>
        </button>
        @foreach (var st in StatusOrder)
        {
            var chosen = st;
            <button class="filter-chip @FilterClass(chosen) @(_statusFilter == chosen ? "active" : "")" @onclick="() => SetFilter(chosen)">
                @chosen <span class="count">@CountOf(chosen)</span>
            </button>
        }
    </div>

    @if (VisibleSnapshots().Count == 0)
    {
        <div class="empty-state" style="margin-top:16px;">
            @if (_snapshots.Count == 0)
            {
                <text>Sensors are registered but none have reported yet. Press <strong>▶ Start</strong> above to simulate readings.</text>
            }
            else
            {
                <text>No sensors match this filter right now.</text>
            }
        </div>
    }
    else
    {
        <div class="telemetry-grid">
            @foreach (var snap in VisibleSnapshots())
            {
                var statusClass = StatusClass(snap.Status);
                var spark = BuildSpark(snap.Sparkline);
                var sparkColor = SparklineColor(snap.Status);
                var gradientId = $"grad-{snap.SensorId}";

                <div class="telemetry-card @statusClass">
                    <div class="telemetry-card-head">
                        <div class="telemetry-name-group">
                            <span class="telemetry-icon">@CategoryIcon(snap.Category)</span>
                            <div>
                                <div class="telemetry-name">@snap.DisplayName</div>
                                <div class="telemetry-zone">@snap.Zone</div>
                            </div>
                        </div>
                        <span class="telemetry-badge @statusClass">@snap.Status</span>
                    </div>

                    <div class="telemetry-value-row">
                        <span class="telemetry-value">@snap.LatestValue.ToString("0.0", CultureInfo.InvariantCulture)@snap.Unit</span>
                        <span class="telemetry-delta @DeltaClass(snap.DeltaPercent)">
                            @(snap.DeltaPercent >= 0 ? "▲" : "▼") @Math.Abs(snap.DeltaPercent).ToString("0.0", CultureInfo.InvariantCulture)%
                        </span>
                    </div>

                    <svg class="telemetry-sparkline" viewBox="0 0 240 64">
                        @if (snap.Sparkline.Length > 1)
                        {
                            <defs>
                                <linearGradient id="@gradientId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="@sparkColor" stop-opacity="0.38" />
                                    <stop offset="100%" stop-color="@sparkColor" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@spark.Fill" fill="url(#@gradientId)" stroke="none" />
                            <polyline points="@spark.Line" fill="none" stroke="@sparkColor" stroke-width="2.2"
                                      stroke-linecap="round" stroke-linejoin="round" />
                            <circle class="spark-dot" cx="@spark.LastX" cy="@spark.LastY" r="3.6" fill="@sparkColor" />
                        }
                        else
                        {
                            <line x1="0" y1="32" x2="240" y2="32" stroke="var(--border-bright)" stroke-width="1.5" stroke-dasharray="4 5" />
                        }
                    </svg>

                    @if (snap.Sparkline.Length > 0)
                    {
                        <div class="spark-stats">
                            <span class="spark-stat">Min <b>@snap.Sparkline.Min().ToString("0.0", CultureInfo.InvariantCulture)</b></span>
                            <span class="spark-stat">Avg <b>@snap.Sparkline.Average().ToString("0.0", CultureInfo.InvariantCulture)</b></span>
                            <span class="spark-stat">Max <b>@snap.Sparkline.Max().ToString("0.0", CultureInfo.InvariantCulture)</b></span>
                        </div>
                    }

                    <div class="telemetry-footer">
                        <span>
                            @if (snap.Status == TelemetryStatus.Disconnected)
                            {
                                <text>No telemetry for @snap.SecondsSinceUpdate.ToString("0", CultureInfo.InvariantCulture)s</text>
                            }
                            else
                            {
                                <text>Updated @snap.SecondsSinceUpdate.ToString("0", CultureInfo.InvariantCulture)s ago</text>
                            }
                        </span>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private static readonly TelemetryStatus[] StatusOrder =
    {
        TelemetryStatus.Anomalous,
        TelemetryStatus.Warning,
        TelemetryStatus.Disconnected,
        TelemetryStatus.Normal
    };

    private List<DeviceProfile>? _sensors;
    private List<TelemetrySnapshotDto> _snapshots = new();
    private readonly HashSet<string> _running = new();
    private TelemetryStatus? _statusFilter;
    private bool _apiOnline = true;

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private string? _meterA;
    private string? _meterB;
    private string? _aggregateResult;
    private DateTimeOffset _lastPolled = DateTimeOffset.Now;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _sensors = await Api.GetSensorsAsync();
            if (_sensors.Count > 0)
            {
                _meterA = _sensors[0].Id;
                _meterB = _sensors[Math.Min(1, _sensors.Count - 1)].Id;
            }
            await RefreshAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _apiOnline = false;
            _sensors ??= new List<DeviceProfile>();
        }

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = PollLoopAsync(_cts.Token);
    }

    private async Task PollLoopAsync(CancellationToken token)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(token))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on dispose.
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            _snapshots = await Api.GetAllTelemetryAsync();
            _lastPolled = DateTimeOffset.Now;
            _apiOnline = true;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _apiOnline = false;
        }
    }

    private async Task ManualRefreshAsync()
    {
        await RefreshAsync();
        StateHasChanged();
    }

    private bool IsRunning(string sensorId) => _running.Contains(sensorId);

    private async Task ToggleSimulationAsync(string sensorId)
    {
        if (IsRunning(sensorId))
        {
            await Api.StopSimulationAsync(sensorId);
            _running.Remove(sensorId);
        }
        else
        {
            await Api.StartSimulationAsync(sensorId);
            _running.Add(sensorId);
        }
    }

    private async Task AggregateAsync()
    {
        if (string.IsNullOrEmpty(_meterA) || string.IsNullOrEmpty(_meterB)) return;

        var result = await Api.AggregateMetersAsync(_meterA, _meterB);
        if (result is System.Text.Json.JsonElement el &&
            el.TryGetProperty("meter1", out var m1) &&
            el.TryGetProperty("meter2", out var m2) &&
            el.TryGetProperty("aggregate", out var agg))
        {
            double w1 = m1.GetProperty("watts").GetDouble();
            double w2 = m2.GetProperty("watts").GetDouble();
            double w3 = agg.GetProperty("watts").GetDouble();
            _aggregateResult = string.Format(CultureInfo.InvariantCulture, "{0:0.0} + {1:0.0} = {2:0.0}", w1, w2, w3);
        }
        else
        {
            _aggregateResult = "No readings yet for one of those sensors.";
        }
    }

    private void SetFilter(TelemetryStatus? status) => _statusFilter = status;

    private int CountOf(TelemetryStatus status) => _snapshots.Count(s => s.Status == status);

    private int HealthyPercent =>
        _snapshots.Count == 0 ? 0 : (int)Math.Round(100.0 * CountOf(TelemetryStatus.Normal) / _snapshots.Count);

    /// <summary>Most urgent first (anomalous, warning, disconnected, normal), then alphabetical.</summary>
    private List<TelemetrySnapshotDto> VisibleSnapshots() =>
        _snapshots
            .Where(s => _statusFilter is null || s.Status == _statusFilter)
            .OrderBy(s => Array.IndexOf(StatusOrder, s.Status))
            .ThenBy(s => s.DisplayName)
            .ToList();

 
    private string DonutDash()
    {
        const double circumference = 2 * Math.PI * 38;
        double filled = circumference * HealthyPercent / 100.0;
        return string.Format(CultureInfo.InvariantCulture, "{0:0.0} {1:0.0}", filled, circumference);
    }

    private string DonutTone()
    {
        int pct = HealthyPercent;
        if (_snapshots.Count == 0 || pct >= 80) return "";
        return pct >= 50 ? "mid" : "low";
    }


    private static MarkupString CategoryIcon(SensorCategory category) => category switch
    {
        SensorCategory.Environmental => new MarkupString(
            "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'>" +
            "<path d='M12 3a2.5 2.5 0 0 0-2.5 2.5v7.6a4 4 0 1 0 5 0V5.5A2.5 2.5 0 0 0 12 3Z' stroke='currentColor' stroke-width='1.5'/>" +
            "<circle cx='12' cy='17' r='1.6' fill='currentColor'/></svg>"),
        SensorCategory.PowerConsumption => new MarkupString(
            "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'>" +
            "<path d='M13 2 4 14h6l-1 8 9-12h-6l1-8Z' stroke='currentColor' stroke-width='1.4' stroke-linejoin='round'/></svg>"),
        SensorCategory.Actuator => new MarkupString(
            "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'>" +
            "<rect x='3' y='8' width='18' height='8' rx='4' stroke='currentColor' stroke-width='1.5'/>" +
            "<circle cx='16' cy='12' r='2.4' fill='currentColor'/></svg>"),
        _ => new MarkupString(string.Empty)
    };

    private static string StatusClass(TelemetryStatus status) => status switch
    {
        TelemetryStatus.Normal => "status-normal",
        TelemetryStatus.Warning => "status-warning",
        TelemetryStatus.Anomalous => "status-anomalous",
        TelemetryStatus.Disconnected => "status-disconnected",
        _ => "status-normal"
    };

    private static string FilterClass(TelemetryStatus status) => status switch
    {
        TelemetryStatus.Normal => "fc-normal",
        TelemetryStatus.Warning => "fc-warning",
        TelemetryStatus.Anomalous => "fc-anomalous",
        TelemetryStatus.Disconnected => "fc-disconnected",
        _ => "fc-normal"
    };

    private static string DeltaClass(double deltaPercent)
    {
        if (deltaPercent > 0.5) return "up";
        if (deltaPercent < -0.5) return "down";
        return "flat";
    }

    private static string SparklineColor(TelemetryStatus status) => status switch
    {
        TelemetryStatus.Normal => "#3DDC97",
        TelemetryStatus.Warning => "#F2B134",
        TelemetryStatus.Anomalous => "#F0555B",
        TelemetryStatus.Disconnected => "#5B6472",
        _ => "#3DDC97"
    };

    private static (string Line, string Fill, string LastX, string LastY) BuildSpark(double[] values)
    {
        const double width = 240;
        const double height = 64;
        const double pad = 7;

        if (values.Length < 2)
        {
            return ("", "", "0", "0");
        }

        var inv = CultureInfo.InvariantCulture;
        double min = values.Min();
        double max = values.Max();
        double range = max - min;
        if (range < 1e-9) range = 1;

        var points = new List<string>(values.Length);
        double lastX = 0, lastY = 0;
        for (int i = 0; i < values.Length; i++)
        {
            double x = (double)i / (values.Length - 1) * width;
            double normalized = (values[i] - min) / range;
            double y = pad + (1 - normalized) * (height - 2 * pad);
            points.Add($"{x.ToString("F1", inv)},{y.ToString("F1", inv)}");
            lastX = x;
            lastY = y;
        }

        string line = string.Join(" ", points);
        string fill = $"{line} {width.ToString("F1", inv)},{height.ToString("F1", inv)} 0.0,{height.ToString("F1", inv)}";
        return (line, fill, lastX.ToString("F1", inv), lastY.ToString("F1", inv));
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
        await Task.CompletedTask;
    }
}