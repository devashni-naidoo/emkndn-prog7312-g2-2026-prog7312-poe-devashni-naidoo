    }

        .sx-intro-content h2 span {
            display: block;
            color: var(--sx-teal);
            font-family: Georgia, serif;
            font-weight: 400;
            font-style: italic;
        }

    .sx-intro-content p, .sx-heading-row > p, .sx-telemetry-copy p, .sx-principles-heading p, .sx-closing-copy p {
        color: var(--sx-muted);
        font-size: .9rem;
        line-height: 1.85;
    }

    .sx-intro-visual {
        position: relative;
        display: grid;
        min-height: 250px;
        place-items: center;
        overflow: hidden;
        border: 1px solid var(--sx-line);
        border-radius: 12px;
        background: radial-gradient(circle at 50% 45%, rgba(114,224,195,.14), transparent 45%), #111a25;
    }

    .sx-visual-grid {
        position: absolute;
        inset: 0;
        opacity: .25;
