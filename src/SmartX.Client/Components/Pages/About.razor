        line-height: 1.9;
    }

    .sx-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 28px;
    }

        .sx-tags span {
            padding: 9px 13px;
            border: 1px solid var(--sx-line);
            border-radius: 999px;
            color: #c3d4dc;
            font-size: .72rem;
            background: rgba(255,255,255,.025);
        }

    .sx-hero-index {
