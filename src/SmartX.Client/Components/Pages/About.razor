    }

    .sx-link-b {
        top: 40%;
        left: 62%;
        width: 25%;
        transform: rotate(-30deg);
    }

    .sx-link-c {
        top: 57%;
        left: 56%;
        width: 31%;
        transform: rotate(42deg);
    }

    .sx-link-d {
        top: 68%;
        left: 31%;
        width: 26%;
