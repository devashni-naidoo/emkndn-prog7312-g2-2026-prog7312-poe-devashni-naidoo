@page "/sensors/register"
@rendermode InteractiveServer
@using SmartX.Shared.Dtos
@using SmartX.Shared.Models
@using SmartX.Client.Services
@inject SmartXApiClient Api

<PageTitle>Smart-X · Register Sensor</PageTitle>

<div class="page-header">
    <h1>Register Sensor</h1>
    <p>
        Simulate or attach a device record. The deployment path (Facility &rarr;
        Zone &rarr; Sub-Zone &rarr; Node) is validated recursively server-side
        before the sensor is accepted.
    </p>
</div>

<div class="panel" style="max-width: 640px;">
    <EditForm Model="_form" OnValidSubmit="SubmitAsync">
        <div class="field-grid">
            <div class="field">
                <label for="mac">MAC address / unique identifier</label>
                <input id="mac" @bind="_form.MacAddress" placeholder="AA:BB:CC:DD:EE:01" />
            </div>
            <div class="field">
                <label for="category">Sensor category</label>
                <select id="category" @bind="_form.Category">
                    <option value="@SensorCategory.Environmental">Environmental</option>
                    <option value="@SensorCategory.PowerConsumption">Power Consumption</option>
                    <option value="@SensorCategory.Actuator">Actuator</option>
                </select>
            </div>

            <div class="field">
                <label for="facility">Facility</label>
                <input id="facility" @bind="_form.Facility" placeholder="Facility A" />
            </div>
            <div class="field">
                <label for="zone">Zone</label>
                <input id="zone" @bind="_form.Zone" placeholder="Zone 1" />
            </div>
            <div class="field">
                <label for="subzone">Sub-Zone</label>
                <input id="subzone" @bind="_form.SubZone" placeholder="Sub-Zone B" />
            </div>
            <div class="field">
                <label for="node">Node ID</label>
                <input id="node" @bind="_form.NodeId" placeholder="Node-07" />
            </div>
            <div class="field" style="grid-column: 1 / -1;">
                <label for="room">Room</label>
                <input id="room" @bind="_form.Room" placeholder="Server Room 2" />
                <span class="field-hint">Descriptive only — not part of the validated hierarchy.</span>
            </div>
        </div>

        <div style="margin-top: 16px; display:flex; align-items:center; gap: 10px;">
            <button class="btn btn-primary" type="submit" disabled="@_submitting">
                @(_submitting ? "Registering..." : "Register sensor")
            </button>
        </div>
    </EditForm>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="banner banner-error" style="margin-top:14px;">@_errorMessage</div>
    }
    @if (_registeredProfile is not null)
    {
        <div class="banner banner-success" style="margin-top:14px;">
            Registered <strong>@_registeredProfile.Location.NodeId</strong> —
            @_registeredProfile.Location.Facility &rarr; @_registeredProfile.Location.Zone &rarr;
            @_registeredProfile.Location.SubZone &rarr; @_registeredProfile.Location.NodeId
        </div>

        <div style="margin-top:16px;">
            <label style="font-size:0.8rem; color:var(--text-dim); font-weight:500; display:block; margin-bottom:8px;">
                Attach config file / deployment photo / hardware log
            </label>

            <div class="dropzone">
                <span class="dropzone-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 16V4M12 4l-4 4M12 4l4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </span>
                <span class="dropzone-title">Click to browse, or drop a file here</span>
                <span class="dropzone-hint">Config files, deployment photos, or hardware logs — up to 10 MB</span>
                <InputFile OnChange="OnFileSelectedAsync" />
            </div>

            @if (_uploading)
            {
                <div class="file-chip" style="margin-top:10px;">
                    <span class="spinner"></span>
                    <span class="file-chip-name">Uploading @_uploadingFileName ...</span>
                </div>
            }

            @if (_uploadedFiles.Count > 0)
            {
                <div class="file-chip-list">
                    @foreach (var f in _uploadedFiles)
                    {
                        <div class="file-chip">
                            <span class="file-chip-icon">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M7 3h7l4 4v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                                    <path d="M14 3v4h4" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                                </svg>
                            </span>
                            <span class="file-chip-name">@f.Name</span>
                            <span class="file-chip-meta">@FormatSize(f.SizeBytes)</span>
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_uploadError))
            {
                <div class="file-chip file-chip-error" style="margin-top:10px;">
                    <span class="file-chip-icon">!</span>
                    <span class="file-chip-name">@_uploadError</span>
                </div>
            }
        </div>
    }
</div>

<h2 style="margin-top:32px;">Registered Sensors</h2>
@if (_sensors is null)
{
    <p class="field-hint">Loading...</p>
}
else if (_sensors.Count == 0)
{
    <div class="empty-state">No sensors registered yet — use the form above.</div>
}
else
{
    <table class="table-simple">
        <thead>
            <tr>
                <th>Node</th>
                <th>MAC</th>
                <th>Category</th>
                <th>Deployment path</th>
                <th>Attachments</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _sensors)
            {
                <tr>
                    <td>@s.Location.NodeId</td>
                    <td style="font-family: var(--font-mono); font-size: 0.82rem;">@s.MacAddress</td>
                    <td>@s.Category</td>
                    <td>@s.Location.Facility &rarr; @s.Location.Zone &rarr; @s.Location.SubZone</td>
                    <td>
                        <span class="attachment-count">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M7 3h7l4 4v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                            </svg>
                            @s.Attachments.Count
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly RegisterSensorRequest _form = new();
    private List<DeviceProfile>? _sensors;
    private DeviceProfile? _registeredProfile;
    private string? _errorMessage;
    private string? _uploadError;
    private string _uploadingFileName = "";
    private readonly List<(string Name, long SizeBytes)> _uploadedFiles = new();
    private bool _submitting;
    private bool _uploading;

    protected override async Task OnInitializedAsync() => await ReloadSensorsAsync();

    private async Task ReloadSensorsAsync()
    {
        _sensors = await Api.GetSensorsAsync();
    }

    private async Task SubmitAsync()
    {
        _errorMessage = null;
        _registeredProfile = null;
        _uploadError = null;
        _uploadedFiles.Clear();

        if (string.IsNullOrWhiteSpace(_form.MacAddress) || string.IsNullOrWhiteSpace(_form.Facility) ||
            string.IsNullOrWhiteSpace(_form.Zone) || string.IsNullOrWhiteSpace(_form.SubZone) ||
            string.IsNullOrWhiteSpace(_form.NodeId))
        {
            _errorMessage = "MAC address, Facility, Zone, Sub-Zone and Node ID are all required.";
            return;
        }

        _submitting = true;

        var (success, error, profile) = await Api.RegisterSensorAsync(_form);
        if (success)
        {
            _registeredProfile = profile;
            await ReloadSensorsAsync();
        }
        else
        {
            _errorMessage = error ?? "Registration failed.";
        }

        _submitting = false;
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        if (_registeredProfile is null) return;

        _uploading = true;
        _uploadError = null;
        _uploadingFileName = e.File.Name;
        StateHasChanged();

        const long maxSize = 10 * 1024 * 1024;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxSize);
            var (success, error) = await Api.UploadMediaAsync(
                _registeredProfile.Id, stream, file.Name, file.ContentType);

            if (success)
            {
                _uploadedFiles.Add((file.Name, file.Size));
                await ReloadSensorsAsync();
            }
            else
            {
                _uploadError = error ?? "Upload failed.";
            }
        }
        catch (Exception ex)
        {
            _uploadError = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _uploading = false;
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
}
